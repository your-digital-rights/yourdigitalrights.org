{
  "name": "yourdigitalrights",
  "version": "2.1.0",
  "license": "GPL3",
  "private": true,
  "scripts": {
    "browser-test": "npx playwright test",
    "test": "npm run build && npx playwright test",
    "setup-local-dynamo": "node setup/dynamo-tables",
    "teardown-local-dynamo": "node setup/teardown-dynamo-tables",
    "dev": "npm run extract:i18n && npm run compile:i18n && next dev --webpack",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "start": "next start",
    "build": "npm run extract:i18n && npm run compile:i18n && next build",
    "postbuild": "next-sitemap",
    "deploy": "npx vercel",
    "deploy:prod": "npx vercel --prod",
    "deploy:prod1": "npx vercel alias vercel alias https://opt-out.vercel.app/ yourdigitalrights.org",
    "clean": "rm -rf src/out && rm -rf src/.next && rm -rf ./next",
    "extract:i18n": "formatjs extract 'src/**/*.js' --format crowdin --id-interpolation-pattern '[sha512:contenthash:base64:6]' --out-file lang/en.json",
    "compile:i18n": "formatjs compile-folder --ast --format crowdin lang compiled-lang",
    "check:i18n": "node scripts/check-translations.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.983.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@formatjs/cli": "^6.7.1",
    "@formatjs/intl-datetimeformat": "^6.18.0",
    "@formatjs/intl-getcanonicallocales": "^2.5.5",
    "@formatjs/intl-numberformat": "^8.15.4",
    "@formatjs/intl-pluralrules": "^5.4.4",
    "@formatjs/intl-relativetimeformat": "^12.2.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/material-nextjs": "^7.2.0",
    "@vercel/analytics": "^1.5.0",
    "autoprefixer": "^10.4.21",
    "clean-css": "^5.3.3",
    "cookie-cutter": "^0.2.0",
    "downshift": "^9.0.9",
    "isomorphic-fetch": "^3.0.0",
    "luxon": "^3.6.1",
    "mailto-link": "^2.0.0",
    "next": "^16.3.0",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "nunjucks": "^3.2.4",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "react-share": "^5.2.2",
    "swr": "^2.3.3",
    "uuid": "^14.0.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "babel-plugin-formatjs": "^10.5.38",
    "babel-plugin-jsx-remove-data-test-id": "^3.0.0",
    "mailto-parser": "^1.0.1",
    "npm-check-updates": "^19.6.3",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "diff": "8.0.3",
    "fast-xml-parser": "5.10.1",
    "nanoid": "3.3.17",
    "picomatch": "2.3.2",
    "postcss": "8.5.26",
    "yaml": "1.10.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": false,
    "endOfLine": "lf",
    "arrowParens": "avoid"
  }
}
